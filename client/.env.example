# =============================================================================
# CLIENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update with your actual values
# Only NEXT_PUBLIC_* variables are exposed to the browser
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# For Production: https://api.yourdomain.com
# For Docker: http://server:3001 (internal) or http://localhost:3001 (host)

# -----------------------------------------------------------------------------
# Mapbox Configuration
# -----------------------------------------------------------------------------
# Get your token from: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# -----------------------------------------------------------------------------
# AWS Cognito Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_ID=your_user_pool_id
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_CLIENT_ID=your_app_client_id

# AWS Cognito Region
NEXT_PUBLIC_AWS_COGNITO_REGION=eu-north-1

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
# Options: development, staging, production

# -----------------------------------------------------------------------------
# Setup Instructions
# -----------------------------------------------------------------------------
# 1. Copy this file: cp .env.example .env
# 2. Get Mapbox token: https://account.mapbox.com/
# 3. Get AWS Cognito credentials from AWS Console
# 4. Update API URL for production deployment
