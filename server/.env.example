# =============================================================================
# SERVER ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update with your actual values
# =============================================================================

# Environment
NODE_ENV=development
# Options: development, staging, production

# Server Port
PORT=3001

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL Connection String
DATABASE_URL=postgresql://rentalapp:changeme123@localhost:5432/rentalapp_db?schema=public

# For Docker: postgresql://rentalapp:changeme123@postgres:5432/rentalapp_db
# For Production: Use your cloud database URL

# -----------------------------------------------------------------------------
# MinIO / S3 Storage Configuration
# -----------------------------------------------------------------------------
# AWS Region (required even for MinIO)
AWS_REGION=us-east-1

# MinIO Credentials (same as MINIO_ROOT_USER/PASSWORD)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# Bucket Name
AWS_S3_BUCKET_NAME=rentalapp-properties

# MinIO Endpoint (only for MinIO, remove for real AWS S3)
AWS_ENDPOINT=http://localhost:9000

# Force path style (required for MinIO)
AWS_S3_FORCE_PATH_STYLE=true

# For Production AWS S3, use:
# Remove AWS_ENDPOINT
# Set AWS_S3_FORCE_PATH_STYLE=false
# Use real AWS credentials

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# JWT Secret Key (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000
# For production: https://yourdomain.com

# -----------------------------------------------------------------------------
# AWS Cognito Configuration
# -----------------------------------------------------------------------------
AWS_COGNITO_REGION=eu-north-1
AWS_COGNITO_USER_POOL_ID=your_user_pool_id

# -----------------------------------------------------------------------------
# Generate Strong Secrets
# -----------------------------------------------------------------------------
# Generate JWT_SECRET: openssl rand -base64 32
# Generate passwords: openssl rand -base64 24
